# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real keys.
LLM_PROVIDER=openai_compat
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5433/devpilot
REDIS_URL=redis://localhost:6379/0

# Optional: price of the model in USD per 1M tokens (see backend/src/agent/pricing.py)
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
